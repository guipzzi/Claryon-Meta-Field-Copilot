<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissões confirmadas na doc do DAT (search_dat_docs, 2026-08-13).
      RECORD_AUDIO é nosso (captura HFP via AudioRecord, não passa pelo DAT).
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      Exigida por `GlassesAudioManagerImpl`, que troca `AudioManager.mode` para
      MODE_IN_COMMUNICATION ao abrir o SCO. É permissão normal (concedida na
      instalação), mas sem a declaração a chamada falha em silêncio — a armadilha
      que a nossa própria tabela descreve e que nós cometemos. O manifest do
      sample oficial do DAT declara; o nosso não declarava.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Localização em primeiro plano apenas. ACCESS_BACKGROUND_LOCATION NÃO é
      pedida: o serviço em primeiro plano com tipo `location` já cobre o turno
      inteiro, e a permissão de segundo plano acrescentaria o diálogo "o tempo
      todo" — assustador e desnecessário — sem acrescentar capacidade nenhuma.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Serviço de primeiro plano do pipeline contínuo (M8). Android 14+ exige a
      permissão POR TIPO, além do tipo declarado no <service> e repetido em
      startForeground(); divergir entre os três derruba o serviço.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".ClaryonApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClaryonField">

        <!--
          Attestation do DAT (autenticidade do app). Em Developer Mode NÃO é
          usada e pode ser 0; fora dele, usar os valores do app registrado no
          Wearables Developer Center. Ver docs/GUIA_TECNICO.md e DECISIONS.md.
        -->
        <meta-data
            android:name="com.meta.wearable.mwdat.APPLICATION_ID"
            android:value="0" />
        <meta-data
            android:name="com.meta.wearable.mwdat.CLIENT_TOKEN"
            android:value="0" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Retorno do app Meta AI após o registro dos óculos. Scheme EXCLUSIVO
              (claryonfield://), nunca genérico — evita prender o usuário no app
              Meta AI (armadilha conhecida). VIEW + DEFAULT + BROWSABLE.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="claryonfield" />
            </intent-filter>
        </activity>

        <!--
          O conjunto de tipos aqui é a UNIÃO do que qualquer modo pode usar; o
          startForeground() em runtime declara o subconjunto EXATO do modo
          corrente (PowerPolicy.tiposDeServico) — em Standby, nem microfone nem
          câmera. Sempre iniciado de tela visível (ver CopilotService.iniciar).
        -->
        <service
            android:name=".service.CopilotService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|microphone|camera|location" />
    </application>
</manifest>
